<?xml version="1.0"?>
<ruleset name="Vertex Starter Theme">
	<description>WordPress Coding Standards for the Vertex starter theme.</description>
	<file>.</file>
	<exclude-pattern>vertex/*</exclude-pattern>
	<exclude-pattern>vendor/*</exclude-pattern>
	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg value="sp"/>
	<config name="minimum_supported_wp_version" value="6.3"/>
	<rule ref="WordPress">
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
		<exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
	</rule>
</ruleset>
